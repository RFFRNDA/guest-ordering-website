generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Outlet {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  address          String?
  phone            String?
  isActive         Boolean  @default(true)
  openTime         String?
  closeTime        String?
  timezone         String   @default("Asia/Jakarta")
  tableNumberLimit Int
  serviceFee       Int      @default(0)
  categories       Category[]
  products         Product[]
  orders           Order[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Category {
  id           String    @id @default(uuid())
  outletId     String
  outlet       Outlet    @relation(fields: [outletId], references: [id])
  name         String
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id           String    @id @default(uuid())
  outletId     String
  outlet       Outlet    @relation(fields: [outletId], references: [id])
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  imageUrl     String?
  price        Int
  isActive     Boolean   @default(true)
  isAvailable  Boolean   @default(true)
  optionGroups ProductOptionGroup[]
  inventory    InventoryItem?
  orderItems   OrderItem[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum SelectionType {
  SINGLE
  MULTIPLE
}

model ProductOptionGroup {
  id            String          @id @default(uuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  name          String
  isRequired    Boolean         @default(false)
  selectionType SelectionType   @default(SINGLE)
  minSelections Int             @default(0)
  maxSelections Int?
  displayOrder  Int             @default(0)
  options       ProductOption[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ProductOption {
  id               String             @id @default(uuid())
  groupId          String
  group            ProductOptionGroup @relation(fields: [groupId], references: [id])
  name             String
  priceAdjustment  Int                @default(0)
  isAvailable      Boolean            @default(true)
  displayOrder     Int                @default(0)
  orderItemOptions OrderItemOption[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model InventoryItem {
  id                String   @id @default(uuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id])
  quantity          Int
  reservedQuantity  Int      @default(0)
  lowStockThreshold Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
}

enum OrderStatus {
  PENDING
  NEW
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

model Order {
  id                   String             @id @default(uuid())
  orderNumber          String             @unique
  outletId             String
  outlet               Outlet             @relation(fields: [outletId], references: [id])
  customerName         String
  customerEmail        String
  orderType            OrderType
  tableNumber          Int?
  status               OrderStatus        @default(PENDING)
  reservationExpiresAt DateTime
  queueNumber          Int?
  queueOperationalDay  String?
  subtotal             Int
  serviceFee           Int
  totalAmount          Int
  items                OrderItem[]
  payment              Payment?
  guestAccesses        GuestOrderAccess[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model OrderItem {
  id                  String            @id @default(uuid())
  orderId             String
  order               Order             @relation(fields: [orderId], references: [id])
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  productNameSnapshot String
  unitPrice           Int
  quantity            Int
  notes               String?
  options             OrderItemOption[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model OrderItemOption {
  id                 String        @id @default(uuid())
  orderItemId        String
  orderItem          OrderItem     @relation(fields: [orderItemId], references: [id])
  optionId           String
  option             ProductOption @relation(fields: [optionId], references: [id])
  optionNameSnapshot String
  priceAdjustment    Int
  createdAt          DateTime      @default(now())
}

model Payment {
  id        String        @id @default(uuid())
  orderId   String        @unique
  order     Order         @relation(fields: [orderId], references: [id])
  method    PaymentMethod
  status    PaymentStatus @default(UNPAID)
  amount    Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model GuestOrderAccess {
  id             String    @id @default(uuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id])
  tokenHash      String    @unique
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  lastAccessedAt DateTime?
  revokedAt      DateTime?
}